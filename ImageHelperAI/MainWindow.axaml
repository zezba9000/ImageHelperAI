<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ImageHelperAI"
        x:Class="ImageHelperAI.MainWindow"
        Width="1120" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Title="ImageHelperAI">
    <TabControl Margin="24,10,24,24">
        <TabItem Header="Sides">
            <local:SidesTab x:Name="Sides" />
        </TabItem>
    </TabControl>
</Window>
